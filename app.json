{
  "expo": {
    "name": "Авто Сканер",
    "slug": "auto-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.rburkit.autoscanner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.rburkit.autoscanner"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Авто Сканер",
      "shortName": "Авто Сканер"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Приложению нужен Bluetooth, чтобы подключиться к OBD2-адаптеру в машине."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/auto-scanner"
    }
  }
}